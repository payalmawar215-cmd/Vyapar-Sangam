# ==============================================================================
# Vyapar Sangam - Backend Environment Configuration Template
# ==============================================================================

# Django Core Settings
SECRET_KEY=generate-a-secure-50-character-secret-key-for-production
DEBUG=False
ALLOWED_HOSTS=vyapar-sangam-backend.onrender.com,localhost,127.0.0.1

# Database Configuration (Render Managed PostgreSQL provides DATABASE_URL automatically)
DATABASE_URL=postgresql://vyapar_user:secure_password@dpg-xxxxxx-a.render.com/vyapar_db

# Alternative individual database credentials (used if DATABASE_URL is not set)
DB_NAME=vyapar_db
DB_USER=vyapar_user
DB_PASSWORD=secure_password
DB_HOST=dpg-xxxxxx-a.render.com
DB_PORT=5432

# CORS & CSRF Configuration
CORS_ALLOWED_ORIGINS=https://vyapar-sangam.onrender.com
CSRF_TRUSTED_ORIGINS=https://vyapar-sangam.onrender.com,https://*.onrender.com

# SSL Security (Render terminates TLS at reverse proxy)
SECURE_SSL_REDIRECT=True

# Email Configuration (Production SMTP vs local console)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=Vyapar Sangam <noreply@vyaparsangam.com>

